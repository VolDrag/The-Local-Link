# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb://localhost:27017/locallink
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret

# Email
EMAIL_VERIFICATION_ENABLED=false
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Platform economics (BDT)
COMMISSION_RATE=0.10
CANCELLATION_FREE_HOURS=24
CANCELLATION_FEE_PERCENT=0.20
NO_SHOW_LIMIT=3
NO_SHOW_WINDOW_DAYS=90
BOOKING_DEFAULT_DURATION_MINUTES=60
# Identity gate: providers cannot confirm bookings until approved
IDENTITY_GATE=true
REFERRAL_CREDIT_BDT=100

# bKash Checkout (sandbox). Leave BKASH_MOCK=true to test without live credentials.
BKASH_MOCK=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:5001/api/payments/bkash/callback

# SMS gateway (SSL Wireless / Alpha SMS). MOCK sends to console.
SMS_MOCK=true
SMS_PROVIDER=sslwireless
SMS_API_URL=
SMS_API_TOKEN=
SMS_SID=
SMS_SENDER=
